# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Anti-spam settings
FLOOD_RATE_LIMIT=5        # Max messages per window
FLOOD_WINDOW_SECONDS=10   # Sliding window size

# Captcha settings
CAPTCHA_TIMEOUT=120       # Seconds to complete captcha
CAPTCHA_TYPE=button       # button or math

# Welcome message auto-delete delay (seconds)
WELCOME_DELETE_AFTER=60

# Raid detection
RAID_JOIN_THRESHOLD=10    # Joins per minute to trigger lockdown
RAID_LOCKDOWN_MINUTES=5

# Database
DATABASE_PATH=bot.db
